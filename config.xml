<?xml version='1.0' encoding='utf-8'?>
<widget id="com.heartcandy.hcbotapp" version="0.2.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Hc Bot App</name>
    <description>Menjalankan Hc-bot langsung di Android dengan Node.js</description>
    <author>Heart candy</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="DisallowOverscroll" value="true" />
    
    <icon src="res/icon.png" />
    <platform name="android">
        
        <preference name="android-minSdkVersion" value="24" />
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" xmlns:android="http://schemas.android.com/apk/res/android" />
        </edit-config>
        <icon src="./res/icon.png" density="ldpi"/>
        <icon src="./res/icon.png" density="mdpi"/>
        <icon src="./res/icon.png" density="hdpi"/>
        <icon src="./res/icon.png" density="xhdpi"/>
        <icon src="./res/icon.png" density="xxhdpi"/>
        <icon src="./res/icon.png" density="xxxhdpi"/>
    </platform>
</widget>
